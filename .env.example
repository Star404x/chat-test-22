# Пример .env файла. Скопируйте в .env и заполните реальные значения

# Порт сервера
PORT=3000

# Подключение к MongoDB (если используется)
MONGODB_URI=mongodb://username:password@host:port/dbname

# Локальная директория для временных загрузок (если используете локальное хранение)
UPLOAD_DIR=uploads

# Cloudinary (опционально) — или используйте AWS S3 / другой провайдер
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Секрет для JWT или других токенов (если требуется)
JWT_SECRET=replace_with_a_secret_value

# Окружение
NODE_ENV=development
