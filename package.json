{
  "name": "leather-mini-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "build": "echo \"No build step - static site is served from public/\"",
    "lint": "eslint . || true",
    "test:playwright": "npx playwright test",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "ci": "npm run lint && npm run test:playwright && npm run test:lighthouse"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.0.0",
    "lhci": "^0.11.0"
  }
}
