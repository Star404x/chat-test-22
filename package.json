{
  "name": "mini-shoes-site",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "test": "jest --coverage",
    "lint": "eslint . --ext .js",
    "optimize": "echo \"Run image optimization and bundle analysis: use Lighthouse, compress images to WebP/AVIF, enable server compression (gzip/brotli) and code-splitting.\""
  },
  "devDependencies": {
    "vite": "^4.4.0",
    "jest": "^29.6.0",
    "eslint": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
